#!/usr/bin/env bash
# Launcher for the Linux (Qt6/PySide6) Diplomat tray applet.
# Runs the package regardless of the current working directory.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="${DIR}${PYTHONPATH:+:$PYTHONPATH}"
# The venv `szpont` makes is where PySide6 is; the autostart entry, the systemd
# timer and the self-update relaunch all start this script without szpont's PATH
# in front of it. It counts once szpont has installed into it - the stamp its deps
# step writes - so one left half-made (Debian without python3-venv stops before
# pip) is passed over for the PATH's python3. It is refreshed only by szpont
# itself: a checkout run by hand beside a stale one runs on it too, until that
# venv is removed.
VENV="$HOME/.diplomat/venv"
if [ -x "$VENV/bin/python3" ] && [ -e "$VENV/.szpont-requirements" ]; then
  exec "$VENV/bin/python3" -m diplomat_app "$@"
fi
exec python3 -m diplomat_app "$@"
